<Window x:Class="HOVS.Plugin.HovsSchemaWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NGraph — Структура ХОВС"
        Height="720" Width="1120" FontSize="13" Icon="/NGraph;component/Resources/Icons/NG_hovs_32.png"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/NGraph;component/Views/CompactDialogStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Разметка структуры ХОВС"
                       Style="{StaticResource Heading}"/>
            <TextBlock Margin="0,5,0,0"
                       Foreground="#52627A"
                       TextWrapping="Wrap"
                       Text="Выберите лист и укажите назначение столбцов. Несколько столбцов можно назначить одному элементу (например, ТО1): их значения будут собраны вместе. Разметка сохранится как профиль и будет использоваться при следующих загрузках."/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#D5DDE9"
                BorderThickness="1"
                Background="#F4F7FC"
                Padding="10"
                Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Width="220" Margin="0,0,16,8">
                    <Label Content="Лист" Target="{Binding ElementName=SheetComboBox}"/>
                    <ComboBox x:Name="SheetComboBox" SelectionChanged="SheetComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <Label Content="Строки заголовка" Target="{Binding ElementName=HeaderRowTextBox}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HeaderRowTextBox" Width="60"/>
                        <TextBlock Text="—" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="LastHeaderRowTextBox" Width="60" ToolTip="Последняя строка заголовка"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <Label Content="Данные со строки" Target="{Binding ElementName=FirstDataRowTextBox}"/>
                    <TextBox x:Name="FirstDataRowTextBox" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Width="220" Margin="0,0,16,8">
                    <Label Content="Название профиля" Target="{Binding ElementName=ProfileNameTextBox}"/>
                    <TextBox x:Name="ProfileNameTextBox" ToolTip="Название сохраняемого профиля ХОВС"/>
                </StackPanel>
                <Button Content="Перечитать" VerticalAlignment="Bottom" Margin="0,0,0,8" Click="Rebuild_Click"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="ColumnsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF7F9FC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Столбец"
                                    Width="78"
                                    IsReadOnly="True"
                                    Binding="{Binding ColumnLabel}"/>
                <DataGridTextColumn Header="Заголовок XLSX"
                                    Width="2*"
                                    IsReadOnly="True"
                                    Binding="{Binding Header}"/>
                <DataGridTextColumn Header="Примеры значений"
                                    Width="3*"
                                    IsReadOnly="True"
                                    Binding="{Binding Samples}"/>
                <DataGridComboBoxColumn x:Name="SemanticColumn"
                                        Header="Назначение в NGraph"
                                        Width="240"
                                        SelectedItemBinding="{Binding SelectedSemantic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusText"
                           Foreground="#FF555555"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF777777"
                           TextWrapping="Wrap"
                           Text="Важно: «Расход L» — подтверждающий расход установки. L наружный и L рециркуляционный сохраняются отдельно и не заменяют обязательный расход установки."/>
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Отмена" IsCancel="True"
                        Margin="6,0,0,0"
                        />
                <Button Content="Подтвердить и запомнить"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="Accept_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
