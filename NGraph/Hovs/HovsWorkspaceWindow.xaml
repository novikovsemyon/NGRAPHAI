<Window x:Class="NGraph.Views.HovsWorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NGraph — Анализ ХОВС" Width="1180" Height="720" MinWidth="900" MinHeight="550" FontSize="13" Icon="/NGraph;component/Resources/Icons/NG_hovs_32.png" Closing="Window_Closing">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/NGraph;component/Views/CompactDialogStyles.xaml"/></ResourceDictionary.MergedDictionaries>
<ContextMenu x:Key="ProjectMenu" x:Shared="False">
  <MenuItem Header="Переименовать…" Click="RenameProject_Click"/>
  <MenuItem Header="Сравнить ревизии…" Click="Compare_Click"/>
  <Separator/>
  <MenuItem Header="Удалить объект…" Click="DeleteProject_Click"/>
</ContextMenu>
<ContextMenu x:Key="RevisionMenu" x:Shared="False">
  <MenuItem Header="Открыть" Click="OpenRevision_Click"/>
  <MenuItem Header="Сравнить ревизии…" Click="Compare_Click"/>
  <Separator/>
  <MenuItem Header="Удалить ревизию…" Click="DeleteRevision_Click"/>
</ContextMenu>
</ResourceDictionary></Window.Resources>
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,6"><TextBlock Style="{StaticResource Heading}" Text="ХОВС · объекты и обучение"/><TextBlock Text="Выберите объект и ревизию. Данные и обучение хранятся отдельно от проекта Revit." TextWrapping="Wrap"/><TextBlock x:Name="CurrentContext" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
<TabControl Grid.Row="1" x:Name="Tabs">
<TabItem Header="Объекты"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><Button DockPanel.Dock="Right" Content="Создать объект" Click="CreateProject_Click"/><TextBox x:Name="ProjectName" ToolTip="Название нового объекта"/></DockPanel>
<Label Grid.Row="1" Content="Объекты и ревизии · ПКМ: переименование, удаление, сравнение"/>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
<ListBox x:Name="Projects" DisplayMemberPath="Name" SelectionChanged="Project_Changed"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><EventSetter Event="PreviewMouseRightButtonDown" Handler="Project_RightClick"/><Setter Property="ContextMenu" Value="{StaticResource ProjectMenu}"/></Style></ListBox.ItemContainerStyle></ListBox>
<DataGrid Grid.Column="2" x:Name="Revisions" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"><DataGrid.RowStyle><Style TargetType="DataGridRow"><EventSetter Event="PreviewMouseRightButtonDown" Handler="Revision_RightClick"/><Setter Property="ContextMenu" Value="{StaticResource RevisionMenu}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="Ревизия" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Дата" Binding="{Binding CreatedLocal}" Width="155"/></DataGrid.Columns></DataGrid>
</Grid><WrapPanel Grid.Row="3" Margin="0,8,0,0"><Button Content="Импорт XLSX…" Click="Import_Click"/><Button Content="Открыть ревизию" Click="OpenRevision_Click"/><Button Content="Сравнить ревизии…" Click="Compare_Click"/><CheckBox x:Name="ForceSchema" Content="Разметить структуру заново" VerticalAlignment="Center" Margin="16,0"/></WrapPanel>
</Grid></TabItem>
<TabItem Header="Установки"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Style="{StaticResource Body}" Text="Отметьте установки для обработки и исправьте состав. Без положительного L строка остаётся кандидатом. Обучение использует только изменённые поля выбранных строк."/>
<DataGrid Grid.Row="1" x:Name="Installations" AutoGenerateColumns="False" SelectionMode="Extended" SelectionChanged="Installation_Changed"><DataGrid.Columns>
<DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Selected}" Width="45"/><DataGridTextColumn Header="Обозначение" Binding="{Binding Equipment.Id}" IsReadOnly="True" Width="120"/>
<DataGridComboBoxColumn x:Name="TypeColumn" Header="Тип" SelectedItemBinding="{Binding Features.InstallationType}" Width="90"/>
<DataGridTextColumn Header="L, м³/ч" Binding="{Binding Airflow}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Распознавание" Binding="{Binding Confidence}" IsReadOnly="True" Width="110"/>
<DataGridTextColumn Header="Фильтр" Binding="{Binding Features.FilterType}" Width="120"/><DataGridTextColumn Header="Фильтров" Binding="{Binding Features.FilterCount}" Width="90"/>
<DataGridTextColumn Header="Рециркуляция" Binding="{Binding Features.Recirculation}" Width="110"/>
<DataGridTextColumn Header="Рекуператор" Binding="{Binding Features.RecuperatorType}" Width="110"/>
<DataGridTextColumn Header="Теплообменники" Binding="{Binding Features.HeatExchangers}" Width="200"/>
<DataGridTextColumn Header="Увлажнитель" Binding="{Binding Features.HumidifierType}" Width="110"/>
</DataGrid.Columns></DataGrid>
<Expander Grid.Row="2" Header="Исходная строка и основание распознавания" Margin="0,6"><TextBox x:Name="SourceText" Height="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander>
<WrapPanel Grid.Row="3"><Button Content="Сохранить ревизию" Click="Save_Click"/><Button Content="Обучить на исправлениях" Click="Train_Click"/><Button Content="Пересчитать связи" Click="Relations_Click"/></WrapPanel>
</Grid></TabItem>
<TabItem Header="Связи"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Style="{StaticResource Body}" Text="Кандидаты связей по признакам рекуперации, рециркуляции и помещения. Перед проектированием проверьте пары. Исключённые установки и кандидаты без L не участвуют."/>
<DataGrid Grid.Row="1" x:Name="Relations" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Приток" Binding="{Binding SourceId}" Width="120"/><DataGridTextColumn Header="Вытяжка" Binding="{Binding TargetId}" Width="120"/><DataGridTextColumn Header="Связь" Binding="{Binding Kind}" Width="120"/><DataGridTextColumn Header="Оценка" Binding="{Binding Confidence, StringFormat=P0}" Width="80"/><DataGridTextColumn Header="Основание" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem Header="Обучение"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Style="{StaticResource Heading}" Text="Обучение на проверенных исправлениях"/><TextBlock Style="{StaticResource Body}" Text="1. Импортируйте XLSX и подтвердите назначение колонок. Профиль таблицы сохраняется для следующих импортов.&#10;2. На вкладке «Установки» исправьте тип и состав. Выделите строки, которые проверили.&#10;3. Нажмите «Обучить на исправлениях». Сохраняются только изменённые поля, а не все предположения анализатора.&#10;4. При следующем импорте распознавание учитывает сохранённые примеры. Это локальное обучение правилам и соответствиям, без внешних AI-сервисов."/>
<TextBlock Style="{StaticResource Heading}" Text="Перенос на другой компьютер"/><TextBlock Style="{StaticResource Body}" Text="Закройте окна ХОВС и скопируйте всю папку базы. На другом компьютере выберите её в «Настройки → Файлы». Объекты, XLSX, ревизии, профили колонок и обучение переносятся вместе."/><TextBox x:Name="StoragePath" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock x:Name="TrainingStatus" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
</TabControl>
<DockPanel Grid.Row="2" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Закрыть" Click="Close_Click"/><TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
</Grid></Window>
