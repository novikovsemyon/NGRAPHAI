<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NGraph.Views.NGraphSettingsView" Style="{DynamicResource {x:Type Window}}" WindowStartupLocation="CenterOwner" Title="NGraph — Настройки" Width="800" Height="620" MinWidth="670" MinHeight="510" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CompactDialogStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProjectName" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#52627A"/>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Базы данных">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource Body}" Text="Выберите чертёжные виды текущего проекта или введите имена для другого проекта. Настройки действуют для всех проектов этого пользователя."/>
                        <Label Target="{Binding ElementName=ElementsView}" Content="База элементов"/>
                        <ComboBox x:Name="ElementsView" IsEditable="True" ToolTip="Вид с готовыми графическими элементами"/>
                        <Label Target="{Binding ElementName=FsaView}" Content="База функциональных схем" Margin="0,12,0,0"/>
                        <ComboBox x:Name="FsaView" IsEditable="True"/>
                        <Button Content="Проверить виды" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Check_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Каталоги"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Style="{StaticResource Body}" Text="Параметры цветовых областей определяют колонки каталога. Список содержит параметры экземпляров и типов из текущего проекта; своё имя можно ввести вручную."/><Label Content="Тип области готового решения" Target="{Binding ElementName=RegionType}"/><ComboBox x:Name="RegionType" IsEditable="True" Margin="0,0,0,8"/><Label Content="Наименование варианта" Target="{Binding ElementName=RegionNameParameter}"/><ComboBox x:Name="RegionNameParameter" IsEditable="True" Margin="0,0,0,8"/><Label Content="Группа вариантов" Target="{Binding ElementName=RegionGroupParameter}"/><ComboBox x:Name="RegionGroupParameter" IsEditable="True" Margin="0,0,0,8"/><Label Content="Код / примечание" Target="{Binding ElementName=RegionCodeParameter}"/><ComboBox x:Name="RegionCodeParameter" IsEditable="True" Margin="0,0,0,8"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="ФСА"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Style="{StaticResource Body}" Text="Эти типоразмеры используются при построении ФСА. Выберите существующий тип или введите имя для другого проекта."/><Label Content="Типоразмер оборудования для ФСА" Target="{Binding ElementName=EquipmentType}"/><ComboBox x:Name="EquipmentType" IsEditable="True" Margin="0,0,0,8"/><TextBlock Style="{StaticResource Body}" Text="«ФСА по оборудованию» ищет экземпляры этого типоразмера на активном виде (обычно ГОСТ21.208: Окружность 10 мм), а также типы «Шкаф» и «Empty». Это не вид базы данных."/><Label Content="Тип сигнальной точки" Target="{Binding ElementName=SignalType}"/><ComboBox x:Name="SignalType" IsEditable="True" Margin="0,0,0,8"/><Label Content="Тип точки без маркировки" Target="{Binding ElementName=SignalWithoutTagType}"/><ComboBox x:Name="SignalWithoutTagType" IsEditable="True" Margin="0,0,0,8"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Файлы">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource Heading}" Text="Папка соответствий INI"/>
                        <TextBlock Style="{StaticResource Body}" Text="При построении схем по модели имя INI-файла сопоставляется с ADSK_Группирование, секция — с ADSK_Позиция, а ключ Symbol задаёт тип условного обозначения."/>
                        <Label Target="{Binding ElementName=IniDirectory}" Content="Полный путь к папке"/>
                        <TextBox x:Name="IniDirectory" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8"><Button Content="Выбрать по INI-файлу…" Click="Browse_Click"/><Button Content="Открыть папку" Click="OpenFolder_Click"/></WrapPanel>
                        <TextBlock Style="{StaticResource Body}" Text="Стандартная папка: %APPDATA%\NGraph\Settings. Штатные INI устанавливаются вместе с программой; пользовательские файлы при обновлении сохраняются. Файлы ищутся также во вложенных папках."/>
                        <Label Content="Папка базы ХОВС и обучения" Target="{Binding ElementName=HovsFolder}"/><TextBox x:Name="HovsFolder" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Body}" Text="Объекты, ревизии, исходные XLSX и обучение хранятся здесь. Для переноса скопируйте всю папку на другой компьютер и выберите её в настройках."/><TextBlock Text="Файл пользовательских настроек" FontWeight="SemiBold"/>
                        <TextBox x:Name="SettingsPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#324D70" AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="По умолчанию" HorizontalAlignment="Left" Click="Defaults_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена" Click="Cancel_Click"/>
                <Button Content="Сохранить" IsDefault="True" Background="#245BCC" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
