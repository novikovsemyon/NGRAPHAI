<Window x:Class="NGraph.Views.NGraphCreateSxemaByModelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NGraph — Схема по пространствам" Width="740" Height="540" MinWidth="620" MinHeight="460"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Схема по пространствам модели"/><TextBlock Style="{StaticResource Body}" Text="Выберите параметр и значение для отбора электрооборудования. Группировка: ADSK_Номер секции → уровень → пространство."/><WrapPanel Margin="0,0,0,18" Visibility="Collapsed"><RadioButton x:Name="BySpace" Content="По пространствам" Checked="BySpace_Checked" Margin="0,0,24,0"/><RadioButton x:Name="ByParameter" Content="По параметру" Checked="ByParameter_Checked"/></WrapPanel><Label Content="Параметр отбора" Target="{Binding ElementName=CB_Param}"/><ComboBox x:Name="CB_Param" SelectionChanged="CB_Param_SelectionChanged"/><Label Content="Значение" Target="{Binding ElementName=CB_Value}"/><ComboBox x:Name="CB_Value" SelectionChanged="CB_Value_SelectionChanged"/><Label x:Name="Description" Margin="0,20,0,0"/></StackPanel></ScrollViewer><Button Grid.Row="1" x:Name="Confirm" Content="Построить" Click="Confirm_Click" HorizontalAlignment="Right"/></Grid></Window>