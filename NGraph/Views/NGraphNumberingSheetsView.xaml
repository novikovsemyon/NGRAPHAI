<Window x:Class="NGraph.Views.NGraphNumberingSheetsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NGraph — Нумерация листов" Width="680" Height="480" MinWidth="580" MinHeight="420"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Нумерация листов"/><TextBlock Style="{StaticResource Body}" Text="Выбранные листы нумеруются по существующему номеру. Выберите параметр и начальное значение."/><Label Content="Параметр" Target="{Binding ElementName=CB_Param}"/><ComboBox x:Name="CB_Param" SelectionChanged="CB_Param_SelectionChanged"/><Label Content="Существующие значения"/><ComboBox x:Name="CB_Value" SelectionChanged="CB_Value_SelectionChanged"/><Label Content="Начальный номер" Target="{Binding ElementName=TB_Value}"/><TextBox x:Name="TB_Value" Text="1" TextChanged="TextBox_TextChanged" PreviewTextInput="TB_Value_PreviewTextInput"/></StackPanel></ScrollViewer><Button Grid.Row="1" x:Name="Confirm" Content="Пронумеровать" Click="Confirm_Click" HorizontalAlignment="Right" Margin="0,16,0,0"/></Grid></Window>