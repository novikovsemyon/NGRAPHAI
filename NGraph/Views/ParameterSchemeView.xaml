<Window x:Class="NGraph.Views.ParameterSchemeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NGraph — Схема по параметрам" Width="1120" Height="780" MinWidth="950" MinHeight="640"
        Icon="/NGraph;component/Resources/Icons/NG_structura_32.png">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CompactDialogStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="ParameterPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="DisplayMemberPath" Value="DisplayName"/>
                <Setter Property="TextSearch.TextPath" Value="Name"/>
                <Setter Property="IsTextSearchEnabled" Value="True"/>
                <Setter Property="MaxDropDownHeight" Value="300"/>
                <Setter Property="ToolTip" Value="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Схема по параметрам оборудования" Style="{StaticResource Heading}"/>
            <TextBlock Text="Секция → выбранный источник уровня → название и номер группы из параметров. Привязка к пространству не нужна." TextWrapping="Wrap" Foreground="#52627A" Margin="0,0,0,12"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="405"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <GroupBox Header="Отбор оборудования" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Электрооборудование, у которого ADSK_Группирование содержит АК_." TextWrapping="Wrap" FontSize="12" Foreground="#52627A"/>
                            <Label Content="Параметр фильтра" Target="{Binding ElementName=CB_Param}"/>
                            <ComboBox x:Name="CB_Param" Style="{StaticResource ParameterPicker}" ItemsSource="{Binding FilterParameters}" SelectedItem="{Binding FilterParameter}"/>
                            <Label Content="Значение" Target="{Binding ElementName=CB_Value}"/>
                            <ComboBox x:Name="CB_Value" ItemsSource="{Binding FilterValues}" DisplayMemberPath="Name" SelectedItem="{Binding FilterValue}" MaxDropDownHeight="260"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Группировка на схеме">
                        <StackPanel>
                            <Label Content="Секция / корпус" Target="{Binding ElementName=SectionParameter}"/>
                            <ComboBox x:Name="SectionParameter" Style="{StaticResource ParameterPicker}" ItemsSource="{Binding SectionParameters}" SelectedItem="{Binding SectionParameter}"/>
                            <StackPanel>
                                <Label Content="Название группы — вместо пространства" Target="{Binding ElementName=GroupNameParameter}"/>
                                <ComboBox x:Name="GroupNameParameter" Style="{StaticResource ParameterPicker}" ItemsSource="{Binding Parameters}" SelectedItem="{Binding GroupNameParameter}"/>
                                <Label Content="Номер группы (необязательно)" Target="{Binding ElementName=GroupNumberParameter}"/>
                                <ComboBox x:Name="GroupNumberParameter" Style="{StaticResource ParameterPicker}" ItemsSource="{Binding NumberParameters}" SelectedItem="{Binding GroupNumberParameter}"/>
                            </StackPanel>
                            <Label Content="Источник уровня"/>
                            <WrapPanel Margin="0,2,0,6">
                                <RadioButton x:Name="ModelLevel" Content="Уровень модели" IsChecked="{Binding UseModelLevel}" GroupName="Level" Margin="0,0,14,0"/>
                                <RadioButton x:Name="ParameterLevel" Content="Параметр" IsChecked="{Binding UseParameterLevel}" GroupName="Level"/>
                            </WrapPanel>
                            <ComboBox x:Name="LevelParameter" Style="{StaticResource ParameterPicker}" ItemsSource="{Binding Parameters}" SelectedItem="{Binding LevelParameter}" IsEnabled="{Binding CanChooseLevelParameter}"/>
                            <TextBlock Text="Уровни модели идут по отметке, значения параметра — по возрастанию: 1, 2, 10." TextWrapping="Wrap" FontSize="12" Foreground="#52627A" Margin="0,5,0,0"/>
                            <Label Content="Если поля группировки не заполнены" Target="{Binding ElementName=MissingPolicy}"/>
                            <ComboBox x:Name="MissingPolicy" ItemsSource="{Binding MissingPolicies}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding MissingValues}"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Text="В списках указаны источник параметра и число элементов с заполненным значением. Для поиска начните вводить имя параметра." TextWrapping="Wrap" Foreground="#52627A" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="{Binding GroupsTitle}">
                        <DataGrid x:Name="GroupsPreview" ItemsSource="{Binding Plan.Groups}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,5,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Секция" Binding="{Binding SectionName}" Width="*"/>
                                <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="*"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupCaption}" Width="2*"/>
                                <DataGridTextColumn Header="Кол." Binding="{Binding Count}" Width="48"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem x:Name="SymbolsTab" Header="{Binding SymbolsTitle}">
                        <DataGrid x:Name="EquipmentPreview" ItemsSource="{Binding Symbols}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,5,0,0"
                                  LoadingRow="Equipment_LoadingRow" RowDetailsVisibilityMode="VisibleWhenSelected" SelectionMode="Single" MinRowHeight="86">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="УГО на схеме" Width="130">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Grid Margin="4">
                                            <Image Source="{Binding Preview}" Stretch="Uniform" Height="74">
                                                <Image.ToolTip><ToolTip><StackPanel><Image Source="{Binding Preview}" MaxWidth="384" MaxHeight="384"/><TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" MaxWidth="384"/></StackPanel></ToolTip></Image.ToolTip>
                                            </Image>
                                            <TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" MaxHeight="76">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Preview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                <TextBlock.ToolTip><TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" MaxWidth="380"/></TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Имя панели" Binding="{Binding PanelName}" Width="115"/>
                                <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="80"/>
                                <DataGridTemplateColumn Header="Семейство / Symbol" Width="200">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding FamilyName}" TextWrapping="Wrap"/><TextBlock Text="{Binding Symbol}" TextWrapping="Wrap" FontWeight="SemiBold"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="INI" Binding="{Binding IniFileName}" Width="150"/>
                                <DataGridTextColumn Header="Секция INI" Binding="{Binding IniSection}" Width="100"/>
                                <DataGridTextColumn Header="Проверка" Binding="{Binding MappingStatus}" Width="250"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="75"/>
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="8" MaxWidth="500" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding IniPath}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MappingStatus}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                <TextBlock Text="Параметры секции INI" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding IniValues}" TextWrapping="Wrap" FontFamily="Consolas"/>
                            </StackPanel></DataTemplate></DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{Binding IssuesTitle}">
                        <DataGrid ItemsSource="{Binding Plan.Issues}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,5,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="75"/>
                                <DataGridTextColumn Header="Элемент" Binding="{Binding ElementName}" Width="*"/>
                                <DataGridTextColumn Header="Что проверить" Binding="{Binding Message}" Width="2*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Label Content="Название нового вида" Target="{Binding ElementName=ViewName}"/>
                    <TextBox x:Name="ViewName" Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" LostFocus="ViewName_LostFocus"/>
                    <TextBlock Text="Существующий вид сохраняется; при совпадении названия будет добавлен номер." TextWrapping="Wrap" Foreground="#52627A" FontSize="12" Margin="0,4,0,8"/>
                    <Expander Header="Обозначения из INI" IsExpanded="True">
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="ADSK_Группирование → имя INI; ADSK_Позиция → секция; Symbol → типоразмер УГО." TextWrapping="Wrap" FontSize="12"/>
                            <TextBox Text="{Binding IniDirectory, Mode=OneWay}" IsReadOnly="True" Margin="0,5,0,0"/>
                            <WrapPanel Margin="0,5,0,0">
                                <Button Content="Открыть папку" Click="OpenIniFolder_Click"/>
                                <Button x:Name="EditIni" Content="Редактор INI" Click="EditIni_Click" ToolTip="Редактировать INI выбранной строки оборудования или выбрать файл"/>
                                <Button x:Name="ReloadIni" Content="Перечитать INI" Click="ReloadIni_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding IniStatus}" FontSize="12" Foreground="#52627A"/>
                            <TextBlock x:Name="IniActionStatus" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ValidationText}" Foreground="#AD2234" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена" Click="Cancel_Click"/>
                <Button x:Name="Confirm" Content="Построить схему" IsEnabled="{Binding CanBuild}" IsDefault="True" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
