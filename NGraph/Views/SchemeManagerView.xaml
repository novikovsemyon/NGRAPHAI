<Window x:Class="NGraph.Views.SchemeManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NGraph — Менеджер схем" Width="660" SizeToContent="Height" ResizeMode="NoResize"
        Icon="/NGraph;component/Resources/Icons/NG_structura_32.png">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CompactDialogStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="Как построить структурную схему?" Style="{StaticResource Heading}"/>
        <TextBlock Text="Выберите способ, затем задайте параметры построения." TextWrapping="Wrap" Foreground="#52627A" Margin="0,2,0,14"/>
        <Button x:Name="Spaces" Click="Spaces_Click" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="По пространствам модели" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Секция, уровень и пространство определяются по размещению оборудования в модели." TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Button>
        <Button x:Name="Parameters" Click="Parameters_Click" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="По параметрам оборудования" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Вы задаёте параметры названия и номера группы. Источник уровня — уровень модели или параметр оборудования." TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Button>
        <Button x:Name="Cancel" Content="Отмена" Click="Cancel_Click" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
