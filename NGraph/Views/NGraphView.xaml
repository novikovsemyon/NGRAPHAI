<Window x:Class="NGraph.Views.NGraphView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NGraph — Справка" Width="1020" Height="720" MinWidth="760" MinHeight="520" FontSize="13" Icon="/NGraph;component/Resources/Icons/NG_info_32.png">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CompactDialogStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Открыть PDF" Click="Pdf_Click"/><StackPanel><TextBlock Text="Справка NGraph" Style="{StaticResource Heading}"/><TextBlock x:Name="HeaderVersion" Foreground="#52627A"/></StackPanel></DockPanel>
    <TabControl Grid.Row="1"><TabItem Header="Команды и инструкции"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="190"/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <DockPanel><TextBox DockPanel.Dock="Top" x:Name="Search" Margin="0,0,0,8" TextChanged="Search_Changed" ToolTip="Поиск по названию и тексту инструкции" AutomationProperties.Name="Поиск в справке"/>
        <ListBox x:Name="Topics" SelectionChanged="Topic_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Group}" FontSize="11" Foreground="#52627A"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#D5DDE9"/>
      <FlowDocumentScrollViewer Grid.Column="2" x:Name="Article" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"/>
    </Grid></TabItem>
    <TabItem Header="О программе"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
      <TextBlock Text="NGraph для Autodesk Revit" Style="{StaticResource Heading}"/><TextBlock Style="{StaticResource Body}" Text="Схемы автоматизации, структурные схемы, оформление листов и анализ ХОВС. Сборки для Revit 2021–2027."/>
      <TextBlock x:Name="VersionText" Style="{StaticResource Body}"/>
      <TextBlock x:Name="BuildText" TextWrapping="Wrap" Foreground="#52627A" Margin="0,0,0,12"/>
      <Button Content="Скопировать сведения" Click="Copy_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/>
      <TextBlock Text="Материалы и поддержка" Style="{StaticResource Heading}"/>
      <TextBlock Margin="0,0,0,12"><Hyperlink NavigateUri="https://shsystems.ru" RequestNavigate="Link_RequestNavigate">Shsystems.ru — инструкции и материалы</Hyperlink></TextBlock>
      <TextBlock><Hyperlink NavigateUri="https://beta-bim.com/" RequestNavigate="Link_RequestNavigate">Beta-Bim.com — решения для проектирования</Hyperlink></TextBlock>
    </StackPanel></ScrollViewer></TabItem></TabControl>
    <DockPanel Grid.Row="2" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Закрыть" Click="Close_Click"/><TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
