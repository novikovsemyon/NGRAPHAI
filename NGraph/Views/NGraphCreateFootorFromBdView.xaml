<Window x:Class="NGraph.Views.NGraphCreateFootorFromBdView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NGraph — База данных" Width="1040" Height="720" MinWidth="850" MinHeight="560">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="HeadingText" Style="{StaticResource Heading}"/><TextBlock Text="Выберите группу и вариант. Название и код берутся из параметров цветовой области." Style="{StaticResource Body}"/></StackPanel>
<TextBox Grid.Row="1" x:Name="Search" Margin="0,0,0,14" TextChanged="Filter_Changed" ToolTip="Поиск по наименованию, группе и коду"/>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
<GroupBox Header="Группы"><ListBox x:Name="Groups" SelectionChanged="Group_Changed"/></GroupBox><GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"/>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="110"/></Grid.RowDefinitions>
<DataGrid x:Name="Items" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Item_Changed"><DataGrid.Columns>
<DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="160"/><DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="140"/>
</DataGrid.Columns></DataGrid><TextBox Grid.Row="1" x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
</Grid></Grid>
<Grid Grid.Row="3" Margin="0,14,0,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Label Content="Обозначение установки" Target="{Binding ElementName=ИмяУстановки}"/>
    <TextBox Grid.Column="1" x:Name="ИмяУстановки"/>
    <CheckBox Grid.Row="1" Grid.Column="1" x:Name="IsFSAcreate" Content="Построить футор после вставки" Margin="0,12,0,0"/>
</Grid>
<DockPanel Grid.Row="4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Отмена" Click="Cancel_Click"/><Button x:Name="Insert" Content="Построить" Click="Insert_Click" IsDefault="True"/></StackPanel><TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
</Grid></Window>
